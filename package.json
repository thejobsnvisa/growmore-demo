{
  "name": "growmore-one",
  "private": true,
  "version": "1.0.1",
  "description": "Growmore Immigration Digital Platform",
  "homepage": "https://www.growmore.one",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-routes": "node Scripts/generateRoutes.cjs",
    "generate-static-pages": "node Scripts/generateStaticPages.cjs",
    "build": "shx rm -rf dist && vite build && npm run generate-routes && npm run generate-static-pages && npm run sitemap",
    "preview": "vite preview",
    "postbuild": "react-snap",
    "sitemap": "node Scripts/script.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
  "concurrency": 2,
  "delay": 1000,
  "skipThirdPartyRequests": true,
  "puppeteerArgs": [
    "--no-sandbox",
    "--disable-setuid-sandbox",
    "--disable-dev-shm-usage",
    "--disable-gpu"
  ],
  "puppeteer": {
    "ignoreHTTPSErrors": true
  },
  "includes" : [

  ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "dotenv": "^17.3.1",
    "formidable": "^3.5.4",
    "framer-motion": "^12.34.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.564.0",
    "nodemailer": "^8.0.2",
    "react": "^19.2.0",
    "react-calendly": "^4.4.0",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.2.0",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^7.13.0",
    "react-toastify": "^11.0.5",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sitemap": "^9.0.1",
    "swiper": "^12.1.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "shx": "^0.4.0",
    "sitemap-ts": "^1.10.1",
    "vite": "^7.3.3"
  }
}
